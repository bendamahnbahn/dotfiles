[user]
    name = BenTechCoder
    email = benjaminnlebron@gmail.com
[credential]
	helper = store
[includeIf "gitdir:~/dev/"]
	path = ~/.gitconfig-personal

# employer/machine-specific identities live in an untracked or separately-managed file; missing = ignored
[include]
	path = ~/.gitconfig-local
[safe]
	directory = /src

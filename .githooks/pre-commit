#!/usr/bin/env bash
# Tracked pre-commit hook. Activated by: git config core.hooksPath .githooks   (bootstrap.sh does this)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1. secrets — scan only what is staged
if command -v gitleaks >/dev/null; then
  gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1 || {
    echo "✖ gitleaks found a secret in the staged changes — commit blocked." >&2; exit 1; }
else
  echo "✖ gitleaks not installed (brew install gitleaks) — refusing to commit without a scan." >&2; exit 1
fi

# 2. this repo is PUBLIC — no employer identifiers allowed in staged content
PATTERN='bethel|jw\.org|vault\.bethel|o11n|bethelservice'
# (.githooks/ itself is excluded — this file has to spell the pattern out)
if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -vE '^\+\+\+' | grep -niE "$PATTERN"; then
  echo "✖ employer-specific string in staged changes — that belongs in the private dotfiles repo." >&2; exit 1
fi
